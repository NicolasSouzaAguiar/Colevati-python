a = float(input("digite A:"))
b = float(input("digite B:"))
c = float(input("digite C:"))

delta= b ** 2 - 4 * a * c

if delta < 0:
    print("não tem raizes reais")
elif delta == 0:
    x = -b / (2 * a)
    print("tem uma raiz real: ", x)
else:
    x1 = (-b + delta ** 0.5) / (2 * a)
    x2 = (-b - delta ** 0.5) / (2 * a)

    print("X1 =", x1)
    print("X2 =", x2)