valor1: int = 0
valor2: int = 0

def crescente():

    global valor1
    global valor2

    if valor1 > valor2:
        print(valor2 ,",", valor1)

    elif valor1 == valor2:
        print("Os valores devem ser diferentes um do outro")
    else:
        print(valor1 ,",", valor2)

def main():

    global valor1
    global valor2

    valor1 = int(input("digite o primeiro valor: "))
    valor2 = int(input("digite o segundo valor: "))

    crescente()

if (__name__ == '__main__'):
     main()